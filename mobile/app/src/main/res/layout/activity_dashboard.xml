<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- حالة السيرفر -->
        <TextView
            android:id="@+id/tvServerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ جارٍ فحص الاتصال..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:background="#EEEEEE"
            android:textColor="#B45309" />

        <!-- ترحيب (نفس ID القديم tvWelcome) -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مرحباً بك في المراقب برو"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device ID: -"
            android:textColor="#666666"
            android:textSize="13sp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/tvCompanyInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رمز الشركة: -"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <!-- البصمة: تسجيل حضور بالبصمة (زر النسخة القديمة) -->
        <Button
            android:id="@+id/btnBiometricAttendance"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#4CAF50"
            android:text="تسجيل حضور (بصمة)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- حضور (ID القديم btnCheckIn) -->
        <Button
            android:id="@+id/btnCheckIn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#4CAF50"
            android:text="حضور"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <!-- انصراف (ID القديم btnCheckOut) -->
        <Button
            android:id="@+id/btnCheckOut"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#F44336"
            android:text="تسجيل انصراف (بصمة)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <!-- تحديث الموقع المحلي (زر النسخة القديمة btnLocation) + إرسال الموقع الحالي -->
        <Button
            android:id="@+id/btnSendLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#0891B2"
            android:text="📍 إرسال الموقع الحالي"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnServices"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#2563EB"
            android:text="📁 الخدمات والطلبات"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#D97706"
            android:text="🔔 الإشعارات"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#7C3AED"
            android:text="⚙️ إعدادات التطبيق"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSupport"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#0F766E"
            android:text="🛟 طلب دعم"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#475569"
            android:text="🚪 تسجيل الخروج"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
