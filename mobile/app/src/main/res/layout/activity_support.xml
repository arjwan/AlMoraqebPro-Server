<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvSupportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="طلب دعم"
            android:textColor="#1E293B"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="عنوان الطلب"
                    android:textColor="#334155"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etSupportTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F1F5F9"
                    android:textColor="#1E293B"
                    android:textColorHint="#64748B"
                    android:hint="مثال: مشكلة في تسجيل الحضور"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تفاصيل المشكلة"
                    android:textColor="#334155"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etSupportDetails"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#F1F5F9"
                    android:textColor="#1E293B"
                    android:textColorHint="#64748B"
                    android:gravity="top|start"
                    android:hint="اكتب تفاصيل المشكلة أو السؤال..."
                    android:padding="14dp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnSendSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إرسال طلب الدعم"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:backgroundTint="#f59e0b"
                    android:padding="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnDeveloperInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="معلومات المطور"
                android:textColor="#ffffff"
                android:backgroundTint="#0284c7"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnBackSupport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="عودة"
                android:textColor="#ffffff"
                android:backgroundTint="#475569"
                android:padding="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
