{
  "name": "almoraqebpro-server",
  "version": "1.0.0",
  "description": "AlMoraqebPro Server Backend",
  "author": {
    "name": "mohmmedali",
    "email": "mhmmed1628@gmail.com"
  },
  "main": "desktop/main.js",
  "scripts": {
    "start": "node -r ./server-preload.js -r ./admin-pages-preload.js server.js",
    "build": "npm install",
    "test": "node test/smoke.js",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --publish never",
    "desktop:build:linux": "electron-builder --linux AppImage deb --publish never",
    "desktop:build:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "multer": "^2.2.0"
  },
  "engines": {
    "node": "18.x"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "^26.0.12",
    "mongodb-memory-server": "^11.2.0"
  },
  "build": {
    "appId": "com.almoraqebpro.desktop",
    "productName": "AlMoraqebPro",
    "asar": true,
    "directories": { "output": "dist-desktop" },
    "files": ["desktop/**", "package.json"],
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "icon": "desktop/assets/icon.png" },
    "win": { "target": ["nsis"], "icon": "desktop/assets/icon.ico" },
    "mac": { "target": ["dmg"], "category": "public.app-category.business", "icon": "desktop/assets/icon.icns" }
  }
}
