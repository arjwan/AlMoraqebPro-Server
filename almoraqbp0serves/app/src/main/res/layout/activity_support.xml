<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvSupportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/support_title"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#111827">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/support_subject_label"
                    android:textColor="#475569"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etSupportTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:textColor="#0F172A"
                    android:textColorHint="#94a3b8"
                    android:hint="@string/support_subject_hint"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/support_details_label"
                    android:textColor="#475569"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etSupportDetails"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#FFFFFF"
                    android:textColor="#0F172A"
                    android:textColorHint="#94a3b8"
                    android:gravity="top|start"
                    android:hint="@string/support_details_hint"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnSendSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/support_send"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:backgroundTint="#f59e0b"
                    android:padding="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnDeveloperInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/support_developer_info"
                android:textColor="#ffffff"
                android:backgroundTint="#0284c7"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnBackSupport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/support_back"
                android:textColor="#ffffff"
                android:backgroundTint="#475569"
                android:padding="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
