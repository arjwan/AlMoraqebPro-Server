<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- الشريط العلوي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvServicesTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="المراقب برو"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffff" />

            <TextView
                android:id="@+id/tvConnectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● جارٍ الفحص..."
                android:textSize="11px"
                android:textStyle="bold"
                android:textColor="#fde68a"
                android:background="@drawable/status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- شريط الأخبار والتوجيهات -->
        <TextView
            android:id="@+id/tvTicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ticker_bg"
            android:text="📢 مرحباً بك في خدمات المراقب برو • 🛡️ تأكد من تسجيل بصمة الحضور عند الوصول • 📅 يمكنك إرسال طلبات الإجازة والسلف من هنا"
            android:textColor="#cbd5e1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:ellipsize="marquee"
            android:scrollHorizontally="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="14dp" />

        <!-- بطاقة الترحيب -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/welcome_gradient"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:elevation="6dp">

            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ffffff" />

            <TextView
                android:id="@+id/tvGreetingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textColor="#E3F2FD" />
        </LinearLayout>

        <!-- معلومات الموظف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="16dp"
            android:elevation="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvEmpNameCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الموظف: -"
                android:textColor="#0f172a"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/tvCompanyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الشركة: -"
                android:textColor="#64748b"
                android:textSize="13sp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/tvDeviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الجهاز: -"
                android:textColor="#64748b"
                android:textSize="13sp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/tvAccountState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="حالة الحساب: نشط ✅"
                android:textColor="#16a34a"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- الصف 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cardLoan" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="💰" />
                <TextView style="@style/ServiceTitle" android:text="طلب سلفة" />
                <TextView style="@style/ServiceDesc" android:text="تقديم طلب سلفة مالية" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardLeave" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="📅" />
                <TextView style="@style/ServiceTitle" android:text="طلب إجازة" />
                <TextView style="@style/ServiceDesc" android:text="إجازة اعتيادية أو مرضية" />
            </LinearLayout>
        </LinearLayout>
        <!-- الصف 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cardMyRequests" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="📄" />
                <TextView style="@style/ServiceTitle" android:text="حالة طلباتي" />
                <TextView style="@style/ServiceDesc" android:text="متابعة الطلبات المرسلة" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardAttendanceLog" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="👋" />
                <TextView style="@style/ServiceTitle" android:text="سجل البصمات والحضور" />
                <TextView style="@style/ServiceDesc" android:text="دخول وخروج وتواريخ" />
            </LinearLayout>
        </LinearLayout>
        <!-- الصف 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cardNotifications" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="🔔" />
                <TextView style="@style/ServiceTitle" android:text="إشعارات المدير" />
                <TextView style="@style/ServiceDesc" android:text="رسائل وتنبيهات الإدارة" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardFirstAid" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="⛑️" />
                <TextView style="@style/ServiceTitle" android:text="الإسعافات الأولية" />
                <TextView style="@style/ServiceDesc" android:text="شروحات طبية صوتية" />
            </LinearLayout>
        </LinearLayout>
        <!-- الصف 4 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cardRewards" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="🎁" />
                <TextView style="@style/ServiceTitle" android:text="المكافآت والخصومات" />
                <TextView style="@style/ServiceDesc" android:text="عرض البيانات المتاحة" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardAccountStatus" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="📊" />
                <TextView style="@style/ServiceTitle" android:text="حالة الحساب" />
                <TextView style="@style/ServiceDesc" android:text="فحص السيرفر والجهاز" />
            </LinearLayout>
        </LinearLayout>
        <!-- الصف 5 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/cardSettings" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="⚙️" />
                <TextView style="@style/ServiceTitle" android:text="إعدادات التطبيق" />
                <TextView style="@style/ServiceDesc" android:text="لغة ومظهر واتصال" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cardBack" style="@style/ServiceCard">
                <TextView style="@style/ServiceIcon" android:text="⬅" />
                <TextView style="@style/ServiceTitle" android:text="عودة للبصمة" />
                <TextView style="@style/ServiceDesc" android:text="واجهة الكاميرا والبصمة" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
