<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/register_title"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textColor="#1E293B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCompanyId"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/company_code"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etCompanyName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/company_name"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/employee_name"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/phone_number"
            android:inputType="phone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etJobTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/job_title"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etWorkLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/work_location"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etSalary"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/salary"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <Spinner
            android:id="@+id/spShift"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/etWorkHours"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/work_hours"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etWageType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/wage_type"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etSocialSecurity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:hint="@string/social_security"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="8dp"
            android:clickable="false"
            android:focusable="false"
            android:hint="@string/register_location_not_captured"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"/>

        <Button
            android:id="@+id/btnCaptureLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0284C7"
            android:text="@string/register_capture_location"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSubmitRequest"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#2563EB"
            android:text="@string/send_request"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
