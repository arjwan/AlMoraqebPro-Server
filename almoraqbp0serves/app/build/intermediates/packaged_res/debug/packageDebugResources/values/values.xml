<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="amber">#FACC15</color>
    <color name="bg_navy">#0B1220</color>
    <color name="bg_navy2">#101C33</color>
    <color name="black">#FF000000</color>
    <color name="brand_blue">#1D6FE0</color>
    <color name="brand_blue_dark">#0A4FBF</color>
    <color name="card_dark">#E616233B</color>
    <color name="card_stroke">#24354F</color>
    <color name="field_bg">#F1F5F9</color>
    <color name="green_ok">#22C55E</color>
    <color name="red_danger">#DC2626</color>
    <color name="sky">#38BDF8</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#93A4BD</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">المراقب برو سيرفس</string>
    <style name="Base.Theme.Almoraqbp0serves" parent="Theme.Material3.DayNight.NoActionBar"/>
    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#93A4BD</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="NavItemActive">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#38BDF8</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:padding">6dp</item>
    </style>
    <style name="ServiceCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_dark</item>
        <item name="android:padding">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">4dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ServiceDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#93A4BD</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="ServiceIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="ServiceTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="StatusIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="StatusLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#93A4BD</item>
    </style>
    <style name="StatusTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_dark</item>
        <item name="android:padding">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">3dp</item>
    </style>
    <style name="StatusValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="Theme.Almoraqbp0serves" parent="Base.Theme.Almoraqbp0serves"/>
</resources>