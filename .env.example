# =========================================================
# AlMoraqebPro Server - مثال ملف البيئة
# =========================================================
# للاستخدام المحلي: انسخ هذا الملف إلى .env ثم عبّئ القيم الحقيقية.
#   cp .env.example .env
#
# مهم جدًا: لا تُرفع ملف .env أبدًا إلى Git (مضاف إلى .gitignore).
# على Render تُحقن هذه المتغيرات من لوحة التحكم، ولا يُرفع .env.

# إلزامي - رابط الاتصال بقاعدة البيانات MongoDB (Atlas أو محلي)
MONGO_URI=mongodb://USER:PASSWORD@cluster0.mongodb.net/almoraqebpro?retryWrites=true&w=majority

# إلزامي - كلمة مرور المطور (تُستخدم لتسجيل دخول المطور وأساس للتوقيع)
DEVELOPER_PASSWORD=change-me-to-a-strong-secret

# اختياري - سر توقيع الجلسات. إن لم يُحدد، سيُستخدم DEVELOPER_PASSWORD.
SESSION_SECRET=change-me-to-a-separate-strong-secret

# اختياري - منفذ التشغيل. Render يحدده تلقائيًا عبر متغير PORT.
PORT=3000

# اختياري - قائمة الأصول المسموح بها لـ CORS، تُفصل بفاصلة.
# اتركه فارغًا للسماح لكل الأصول (السلوك الافتراضي الحالي).
# مثال: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=